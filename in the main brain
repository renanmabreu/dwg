KINDS={'.catdrawing':'CATDRAWING','.catpart':'CATPART','.catproduct':'CATPRODUCT'}
def digest_file(path):
    digest=hashlib.sha256()
    with Path(path).open('rb') as f:
        for chunk in iter(lambda:f.read(1024*1024),b''):digest.update(chunk)
    return digest.hexdigest()

def file_index(folder,kinds):
    index={};errors=[]
    for p in sorted(Path(folder).iterdir()):
        kind=KINDS.get(p.suffix.lower())
        if not p.is_file() or kind not in kinds:continue
        matches={m.upper() for m in U.PN.findall(p.stem)}
        if len(matches)!=1:errors.append('Nome sem PN unico: '+p.name);continue
        pn=next(iter(matches));key=(pn,kind)
        if key in index:errors.append('Arquivo duplicado para '+pn+' / '+kind)
        index[key]=str(p.resolve())
    if errors:raise ValueError('\n'.join(errors))
    if not index:raise ValueError('Nenhum arquivo dos tipos selecionados na pasta. Subpastas nao sao incluidas.')
    return index

def make_plan(mode,excel,folder,kinds,env):
    if not re.fullmatch(r'[A-Z0-9_]+',env):raise ValueError('Ambiente invalido.')
    rows=C.read_excel(excel) if mode in ('create','sequence') else []
    index=file_index(folder,kinds) if mode in ('upload','sequence') else {}
    result=[];errors=[]
    if mode=='upload':
        for (pn,kind),path in index.items():
            result.append({'pn':pn,'ambiente':env,'creation':None,'files':[{'pn':pn,'arquivo':path,'kind':kind,'status':'PENDENTE'}]})
    else:
        for r in rows:
            files=[]
            if mode=='sequence':
                for kind in kinds:
                    path=index.get((r['part_number'].upper(),kind))
                    if not path:errors.append('Arquivo ausente: '+r['part_number']+' / '+kind)
                    else:files.append({'pn':r['part_number'],'arquivo':path,'kind':kind,'status':'PENDENTE'})
            result.append({'pn':r['part_number'],'ambiente':r['ambiente'],'creation':dict(r),'files':files})
    if errors:raise ValueError('Nenhum PN foi criado. Corrija a associacao:\n'+'\n'.join(errors))
    if not result:raise ValueError('Plano vazio.')
    for r in result:
        r.update(criacao='PENDENTE' if r['creation'] else 'NAO_SOLICITADA',conteudo='PENDENTE' if r['files'] else 'NAO_SOLICITADO',mensagem='')
        for f in r['files']:
            f['sha256']=digest_file(f['arquivo'])
    return result

