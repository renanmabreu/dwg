                        f['status']='IGNORADO_HISTORICO_LOCAL';self.log.emit('Conteudo ja confirmado localmente para este arquivo: '+f['arquivo']);continue
                    r['conteudo']='EM_EXECUCAO '+f['kind'];f['status']='EM_EXECUCAO';self.publish()
                    self.u.rows=[f];self.setup_upload(r['ambiente'])
                    if f['kind']!='CATDRAWING':
                        self.request_confirmation('3D EXPERIMENTAL: '+f['kind']+'\nArquivo: '+f['arquivo']+'\nO documento DOCCAD correspondente precisa existir no VPM. Nao cria CATPart/CATProduct ausente, nao importa dependencias e nao faz Commit automatico. Continuar?')
                    method=U.Worker.item if f['kind']=='CATDRAWING' else getattr(U,'item_'+f['kind'].lower())
                    method(self.u,cat,f)
                    if f['status']!='CONFIRMADO_PELO_USUARIO':raise RuntimeError('Upload sem confirmacao final.')
                    self.publish()
                if r['files']:r['conteudo']='CONFIRMADO_PELO_USUARIO_OU_HISTORICO'
                r['mensagem']='Etapas solicitadas concluidas; Upload/Commit confirmados pelo usuario quando aplicavel.'
                self.publish();self.progress.emit(int((i+1)/len(self.plan)*100))
            except Exception as exc:
                if r['creation'] and r['criacao']=='EM_EXECUCAO':
                    r['criacao']='CRIACAO_INCERTA' if self.creator.sent else 'ERRO_ANTES_CREATE'
                if self.active_file:
                    f=self.active_file
                    f['status']='UPLOAD_INCERTO' if self.u.sent or f.get('status')=='ENVIO_INICIADO' else 'ERRO_ANTES_UPLOAD'
                    r['conteudo']=f['status']
                elif r['files']:r['conteudo']='NAO_EXECUTADO'
                r['mensagem']=str(exc);self.publish()
                (ROOT/'erro_unificado.txt').write_text(traceback.format_exc(),encoding='utf-8')
                if self.u:
                    try:self.u.diagnostic()
                    except Exception:pass
                for later in self.plan[i+1:]:
                    if later['criacao']=='PENDENTE':later['criacao']='NAO_EXECUTADO'
                    if later['conteudo']=='PENDENTE':later['conteudo']='NAO_EXECUTADO'
                atomic_json(self.report,self.plan)
                self.log.emit(traceback.format_exc());return False,'Lote interrompido em '+r['pn']+'. '+str(exc)
        return True,'Lote concluido. Relatorio: '+self.report.name
    def run(self):
        com=None
        try:
            cat=None
            if any(r['files'] for r in self.plan):
                import pythoncom,win32com.client
                com=pythoncom;com.CoInitialize();cat=win32com.client.GetActiveObject('CATIA.Application')
                self.log.emit('CATIA existente conectado. Nenhuma nova instancia sera iniciada.')
            creation=[r['creation'] for r in self.plan if r['creation']]
            if creation:
                self.creator=CreateAdapter(creation,True);self.creator.stop_event=self.stop
                self.creator.log.connect(self.log.emit,Qt.DirectConnection)
                self.creator.stage.connect(lambda n,t:self.log.emit(t),Qt.DirectConnection)
            if cat:
                self.u=UploadAdapter([],self.plan[0]['ambiente']);self.u.owner=self;self.u.stop=self.stop
                self.u.log.connect(self.log.emit,Qt.DirectConnection)
                self.u.ask.connect(self.notice.emit,Qt.DirectConnection)
            atomic_json(self.report,self.plan)
            with sync_playwright() as pw:
                try:
                    self.ctx=pw.chromium.launch_persistent_context(str(ROOT/'perfil_edge_vpm'),channel='msedge',headless=False)
                    if self.u:self.u.ctx=self.ctx
                    if self.creator:self.creator.upload_guard=self.guard
                    ok,message=self.execute_plan(cat);self.completed.emit(ok,message)
                except Exception:
                    message=traceback.format_exc();(ROOT/'erro_unificado.txt').write_text(message,encoding='utf-8');self.log.emit(message);self.completed.emit(False,'Falha ao iniciar/continuar. Consulte o log.')
                finally:
                    if self.ctx:
                        self.log.emit('Edge aberto para revisao. Use Encerrar sessao antes de outro lote.')
                        while not self.close.is_set():
                            try:
                                if not self.ctx.pages:break
                                self.ctx.pages[0].wait_for_timeout(250)
                            except Exception:break
                        try:self.ctx.close()
                        except Exception:pass
        except Exception:
            self.log.emit(traceback.format_exc());self.completed.emit(False,'Nao foi possivel iniciar. Confira dependencias, historicos e CATIA aberto.')
        finally:
            if com:com.CoUninitialize()

