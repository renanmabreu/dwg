Private Sub FormatarLinhaSAP( _
    ByVal ws As Worksheet, _
    ByVal linha As Long)

    With ws.Range( _
        ws.Cells( _
            linha, _
            DESTINO_PN), _
        ws.Cells( _
            linha, _
            DESTINO_QUANTIDADE))

        .Font.Name = "Aptos Narrow"
        .Font.Size = 11
        .VerticalAlignment = xlCenter
        .HorizontalAlignment = xlCenter

    End With

End Sub

Private Sub FormatarTabelaSAP( _
    ByVal ws As Worksheet, _
    ByVal primeiraLinha As Long, _
    ByVal ultimaLinha As Long)

    Dim intervalo As Range

    If ultimaLinha < primeiraLinha Then Exit Sub

    Set intervalo = ws.Range( _
        ws.Cells( _
            primeiraLinha, _
            DESTINO_PN), _
        ws.Cells( _
            ultimaLinha, _
            DESTINO_QUANTIDADE))

    With intervalo

        .Font.Name = "Segoe UI"
        .Font.Size = 10
        .Font.Bold = False
        .Font.Color = RGB(0, 0, 0)

        .Interior.Color = RGB(255, 255, 255)

        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter

        .Borders(xlEdgeLeft).LineStyle = xlContinuous
        .Borders(xlEdgeTop).LineStyle = xlContinuous
        .Borders(xlEdgeBottom).LineStyle = xlContinuous
        .Borders(xlEdgeRight).LineStyle = xlContinuous
        .Borders(xlInsideVertical).LineStyle = xlContinuous
        .Borders(xlInsideHorizontal).LineStyle = xlContinuous

        .Borders.Color = RGB(217, 217, 217)
        .Borders.Weight = xlThin

    End With

    ws.Range( _
        ws.Cells( _
            primeiraLinha, _
            DESTINO_PN), _
        ws.Cells( _
            ultimaLinha, _
            DESTINO_PN)).NumberFormat = "@"

    ws.Range( _
        ws.Cells( _
            primeiraLinha, _
            DESTINO_POSICAO), _
        ws.Cells( _
            ultimaLinha, _
            DESTINO_POSICAO)).NumberFormat = "@"

    ws.Range( _
        ws.Cells( _
            primeiraLinha, _
            DESTINO_ZONA), _
        ws.Cells( _
            ultimaLinha, _
            DESTINO_ZONA)).NumberFormat = "@"

    ws.Range( _
        ws.Cells( _
            primeiraLinha, _
            DESTINO_QUANTIDADE), _
        ws.Cells( _
            ultimaLinha, _
            DESTINO_QUANTIDADE)).NumberFormat = "0"

End Sub

' ========================================================================
' ORDENAÇÃO
' ========================================================================

Private Sub OrdenarDadosSAP( _
    ByVal ws As Worksheet, _
    ByVal ultimaLinha As Long)

    If ultimaLinha < PRIMEIRA_LINHA_DESTINO Then
        Exit Sub
    End If

    With ws.Sort

        .SortFields.Clear

        .SortFields.Add _
            Key:=ws.Range( _
                ws.Cells( _
                    PRIMEIRA_LINHA_DESTINO, _
                    DESTINO_POSICAO), _
                ws.Cells( _
                    ultimaLinha, _
                    DESTINO_POSICAO)), _
            SortOn:=xlSortOnValues, _
            Order:=xlAscending, _
            DataOption:=xlSortTextAsNumbers

        .SetRange ws.Range( _
            ws.Cells(3, DESTINO_PN), _
            ws.Cells(ultimaLinha, DESTINO_QUANTIDADE))

        .Header = xlYes
        .MatchCase = False
        .Orientation = xlTopToBottom
        .Apply

    End With

End Sub

' ========================================================================
' RESTAURA O ESTADO DO EXCEL
' ========================================================================

Private Sub RestaurarEstadoExcel()

    On Error Resume Next

    Application.DisplayAlerts = True
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    Application.StatusBar = False

    On Error GoTo 0

End Sub



